<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Circular Gradient Background (Matching Phone Branding) -->
    <path
        android:pathData="M54,54m-50,0a50,50 0,1 1,100 0a50,50 0,1 1,-100 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#FFFF5252" /> <!-- Coral Red -->
                <item android:offset="1" android:color="#FFFF4081" /> <!-- Pink Accent -->
            </gradient>
        </aapt:attr>
    </path>

    <!-- Foreground Icon (Dumbbell + Heartbeat) -->
    <group
        android:translateX="27"
        android:translateY="27"
        android:scaleX="2.25"
        android:scaleY="2.25">
        <!-- Dumbbell -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M6,10h2v4h-2z M16,10h2v4h-2z M8,11.5h8v1h-8z" />
        <!-- Heartbeat -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="0.8"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M9,12l1,-4l1.5,8l1,-4" />
    </group>

</vector>
